{
  "name": "jd2resume-backend",
  "version": "1.0.0",
  "description": "Backend API for JD2Resume - Intelligent Job Description Based Resume Builder",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
